# The atmos67 source the package is built from, shared by build.sh and
# build-aarch64.sh: a commit of the atmos67 repository, fetched from GitHub.
# To build a commit not pushed yet, point ATMOS67_REPO at a local clone (for
# example mounted at /atmos67); only committed changes reach the package.
ATMOS67_REV=1f9b623b62770378b66de62ee8f03fcaf96173ad
ATMOS67_URL=https://github.com/saya6k/atmos67
ATMOS67_REPO=${ATMOS67_REPO:-$ATMOS67_URL.git}
ATMOS67_SRC=build/atmos67

fetch_atmos67() {
    rm -rf "$ATMOS67_SRC" build/atmos67.git
    mkdir -p "$ATMOS67_SRC"
    git init -q --bare build/atmos67.git
    # A mounted clone belongs to another user; git refuses it without this.
    git -c safe.directory='*' -C build/atmos67.git fetch -q --depth 1 "$ATMOS67_REPO" "$ATMOS67_REV"
    git -C build/atmos67.git archive "$ATMOS67_REV" | tar -x -C "$ATMOS67_SRC"
}
